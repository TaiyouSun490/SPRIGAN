# Documentation only: FAFNIR does not automatically read .env files.
# Supply these values through the launching process's environment.
# Leave credentials empty until obtained through the provider's official flow.
FAFNIR_MODEL_CACHE=
FAFNIR_SKETCHFAB_CLIENT_ID=
FAFNIR_SKETCHFAB_CLIENT_SECRET=
FAFNIR_SKETCHFAB_REDIRECT_URI=http://127.0.0.1:8770/api/models/oauth_callback
FAFNIR_SKETCHFAB_ACCESS_TOKEN=
TYPESAFE_API_KEY=
FAFNIR_JEV_MODEL=jev-latest
FAFNIR_ANYJEV_MODEL=
FAFNIR_ANYJEV_URL=http://127.0.0.1:8000
